# Local directory for data, plugins, and cached modules
.terraform/
**/.terraform/


# Test execution logs or local crash logs
crash.log
crash.*.log
*.log

# Local state files (If using a local backend instead of a remote S3/GCS backend)
*.tfstate
*.tfstate.backup

# Sensitive variable files containing credentials or secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Local personal overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration file
.terraformrc
terraform.rc

# Ignore execution plans generated by 'terraform plan -out=...'
*tfplan*
